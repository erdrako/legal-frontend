{
  "name": "@lexmapa/frontend",
  "version": "0.1.0",
  "description": "Frontend trazable para visualizar normativa argentina en LexMapa.",
  "type": "module",
  "private": false,
  "scripts": {
    "start": "node scripts/serve-static.mjs",
    "check": "node scripts/check-static-app.mjs && node scripts/audit-ux.mjs --check",
    "audit:ux": "node scripts/audit-ux.mjs",
    "audit:ux:check": "node scripts/audit-ux.mjs --check",
    "audit:ux:full": "powershell -NoProfile -ExecutionPolicy Bypass -File \"..\\UX audit\\run-ux-audit.ps1\" -ProjectRoot \".\"",
    "build:pages": "node scripts/build-pages.mjs"
  }
}
